# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=stevens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stevens_events

# Local dev (app on host, db in Docker). Inside Compose the app uses host "db".
DATABASE_URL=postgresql://stevens:change-me@localhost:5432/stevens_events

AUTH_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000

# Stripe (TEST mode keys until Phase 7)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM="Steven's Events <tickets@example.com>"

# First owner account, created by `npm run db:seed`
SEED_OWNER_EMAIL=you@example.com
SEED_OWNER_PASSWORD=change-me-long-password
