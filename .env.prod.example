# Copy to .env ON THE SERVER and fill in. Never commit it. Used by docker-compose.prod.yml.

# Your site's domain (DNS A record must point at the server). No https://
DOMAIN=tickets.example.com

# Use only letters and digits in the password (it goes inside a URL). Generate: openssl rand -hex 24
POSTGRES_USER=stevens
POSTGRES_PASSWORD=
POSTGRES_DB=stevens_events

# Generate: openssl rand -base64 32
AUTH_SECRET=

# Stripe LIVE keys (Dashboard -> Developers). The webhook secret comes from the live webhook endpoint
# you create for https://YOUR_DOMAIN/api/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend: the From address must be on a domain you have verified in Resend
RESEND_API_KEY=re_...
EMAIL_FROM="Steven's Events <tickets@example.com>"

# Optional: Cloudflare Turnstile bot protection on checkout (leave blank to turn it off)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Off-server backups (any S3-compatible storage, e.g. Backblaze B2 or DigitalOcean Spaces)
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_REMOTE_PATH=offsite:your-bucket-name/stevens-events
